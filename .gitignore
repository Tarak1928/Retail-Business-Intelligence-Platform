@'
# Python environment
venv/
.venv/

# Python cache and testing
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets
.env
.env.*

# Large datasets
data/raw/
data/processed/*.csv

# Experimental model files
models/Experiment_*.txt
models/lightgbm_sales_model.txt

# Temporary files
*.log
.DS_Store
'@ | Set-Content .gitignore

# Allow deployment datasets
!data/
!data/deployment/
!data/deployment/*.csv